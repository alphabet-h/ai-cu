<Window x:Class="PwProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ai-cu pw-probe"
        Width="420"
        Height="220"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=Plain}">
    <StackPanel Margin="16">
        <!-- 見出しの文字列は欄の名前 (ふつうの欄 / パスワード欄) を含まないようにする。
             find の name は部分一致なので、含むと見出しの Text の要素も当たる -->
        <TextBlock Text="ふつう (plain)" Margin="0,0,0,2" />
        <TextBox x:Name="Plain"
                 Text="plain-text"
                 TabIndex="0"
                 AutomationProperties.AutomationId="plain"
                 AutomationProperties.Name="ふつうの欄" />

        <TextBlock Text="パスワード (secret)" Margin="0,10,0,2" />
        <PasswordBox x:Name="Secret"
                     TabIndex="1"
                     AutomationProperties.AutomationId="secret"
                     AutomationProperties.Name="パスワード欄"
                     PasswordChanged="Secret_PasswordChanged" />

        <TextBlock x:Name="Length"
                   Margin="0,12,0,0"
                   AutomationProperties.AutomationId="length" />
    </StackPanel>
</Window>
