{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CARGO_TERM_COLOR": "never",
    "CARGO_TERM_PROGRESS_WHEN": "never",
    "RUST_BACKTRACE": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "allow": [
      "Edit(/**)",

      "Bash(cargo *)",
      "PowerShell(cargo *)",
      "Bash(AI_CU_CONFIG=* cargo *)",
      "Bash(rustup show*)",
      "Bash(rustup component list*)",
      "PowerShell(rustup show*)",
      "PowerShell(rustup component list*)",

      "Bash(mkdir -p target/*)",
      "PowerShell(New-Item -ItemType Directory *)",
      "Bash(echo *)",
      "Bash(python .claude/hooks/test_guard_real_input.py*)",
      "PowerShell(python .claude/hooks/test_guard_real_input.py*)",

      "Bash(target/debug/ai-cu.exe validate *)",
      "Bash(target/debug/ai-cu.exe schema*)",
      "Bash(target/debug/ai-cu.exe --help*)",
      "Bash(target/release/ai-cu.exe validate *)",
      "Bash(target/release/ai-cu.exe schema*)",
      "Bash(target/release/ai-cu.exe --help*)",
      "Bash(target/release/ai-cu.exe *)",

      "Read(~/.cargo/registry/**)",
      "mcp__plugin_microsoft-docs_microsoft-learn",
      "mcp__plugin_context7_context7",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(cargo install *)",
      "Bash(cargo uninstall *)",
      "Bash(cargo publish *)",
      "Bash(cargo login *)",
      "Bash(cargo logout *)",
      "Bash(cargo yank *)",
      "Bash(cargo owner *)",
      "Bash(cargo +*)",
      "Bash(cargo -* install*)",
      "PowerShell(cargo install *)",
      "PowerShell(cargo uninstall *)",
      "PowerShell(cargo publish *)",
      "PowerShell(cargo login *)",
      "PowerShell(cargo logout *)",
      "PowerShell(cargo yank *)",
      "PowerShell(cargo owner *)",
      "PowerShell(cargo +*)",
      "PowerShell(cargo -* install*)",

      "Bash(rustup install *)",
      "Bash(rustup update*)",
      "Bash(rustup default *)",
      "Bash(rustup component add *)",
      "Bash(rustup component remove *)",
      "Bash(rustup target add *)",
      "Bash(rustup target remove *)",
      "Bash(rustup toolchain *)",
      "Bash(rustup self *)",
      "Bash(rustup override *)",
      "Bash(rustup set *)",
      "PowerShell(rustup install *)",
      "PowerShell(rustup update*)",
      "PowerShell(rustup default *)",
      "PowerShell(rustup component add *)",
      "PowerShell(rustup component remove *)",
      "PowerShell(rustup target add *)",
      "PowerShell(rustup target remove *)",
      "PowerShell(rustup toolchain *)",
      "PowerShell(rustup self *)",
      "PowerShell(rustup override *)",
      "PowerShell(rustup set *)",

      "Bash(winget *)",
      "Bash(choco *)",
      "Bash(scoop *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(npm uninstall -g *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(uv tool *)",
      "Bash(uv pip *)",
      "Bash(reg *)",
      "Bash(setx *)",
      "PowerShell(winget *)",
      "PowerShell(choco *)",
      "PowerShell(scoop *)",
      "PowerShell(npm install -g *)",
      "PowerShell(npm i -g *)",
      "PowerShell(npm uninstall -g *)",
      "PowerShell(pip install *)",
      "PowerShell(pip uninstall *)",
      "PowerShell(uv tool *)",
      "PowerShell(uv pip *)",
      "PowerShell(reg *)",
      "PowerShell(setx *)",
      "PowerShell(Install-Module *)",
      "PowerShell(Install-Package *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(Set-ItemProperty *)",
      "PowerShell(New-ItemProperty *)",
      "PowerShell(Remove-ItemProperty *)",
      "PowerShell(Start-Process *)",

      "Bash(claude mcp *)",
      "PowerShell(claude mcp *)",

      "Bash(rm *)",
      "PowerShell(Remove-Item *)",

      "Bash(git config --global *)",
      "Bash(git * config --global *)",
      "Bash(git * config --system *)",
      "PowerShell(git config --global *)",
      "PowerShell(git * config --global *)",
      "PowerShell(git * config --system *)",

      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.cargo/**)",
      "Edit(/.mcp.json)"
    ],
    "deny": [
      "Bash(git difftool)",
      "PowerShell(git difftool)",
      "Bash(git difftool *)",
      "PowerShell(git difftool *)",
      "Bash(git * difftool)",
      "PowerShell(git * difftool)",
      "Bash(git * difftool *)",
      "PowerShell(git * difftool *)",
      "Bash(git * --ext-diff)",
      "PowerShell(git * --ext-diff)",
      "Bash(git * --ext-diff *)",
      "PowerShell(git * --ext-diff *)",
      "Bash(git * --extcmd*)",
      "PowerShell(git * --extcmd*)",
      "Bash(git * --output*)",
      "PowerShell(git * --output*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git reset *--hard*)",
      "Bash(git * reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(git rebase *)",
      "Bash(git * rebase *)",
      "Bash(git * filter-branch*)",
      "Bash(git commit *--amend*)",
      "Bash(git * commit *--amend*)",
      "Bash(git branch *-D *)",
      "Bash(git * branch *-D *)",
      "Bash(git branch *-d *)",
      "Bash(git * branch *-d *)",
      "Bash(git branch *-f *)",
      "Bash(git * branch *-f *)",
      "Bash(git branch *--delete*)",
      "Bash(git * branch *--delete*)",
      "Bash(git branch *--force*)",
      "Bash(git * branch *--force*)",
      "Bash(git * -c *)",
      "Bash(git * --output*)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git * push)",
      "PowerShell(git * push *)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git * reset *--hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git * clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git * rebase *)",
      "PowerShell(git * filter-branch*)",
      "PowerShell(git commit *--amend*)",
      "PowerShell(git * commit *--amend*)",
      "PowerShell(git branch *-D *)",
      "PowerShell(git * branch *-D *)",
      "PowerShell(git branch *-d *)",
      "PowerShell(git * branch *-d *)",
      "PowerShell(git branch *-f *)",
      "PowerShell(git * branch *-f *)",
      "PowerShell(git branch *--delete*)",
      "PowerShell(git * branch *--delete*)",
      "PowerShell(git branch *--force*)",
      "PowerShell(git * branch *--force*)",
      "PowerShell(git * -c *)",
      "PowerShell(git * --output*)",

      "Edit(/Cargo.lock)",
      "Edit(/.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_real_input.py\""
          }
        ]
      }
    ]
  }
}
